# Local development only; never use production credentials.
POSTGRES_USER=unipath
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=unipath_dev
POSTGRES_PORT=5433

# FastAPI connects to Docker's published localhost port.
DATABASE_URL=postgresql://unipath:local-dev-only@127.0.0.1:5433/unipath_dev

FRONTEND_PORT=5173
BACKEND_PORT=8000
